{
    "parent": "builtin/image",
    "image": "customloadingscreen:image/tainted_forces/sec_bar.png",
    "position_type": "CENTER",
    "offset_pos": "CENTER",
    "position": {
        "y": "screen_height * 0.5 - 165 *screen_height / 1088 - forge_progress_bar_percent(1) * screen_height *235 / 1088 /2",
        "x": "-screen_width * 0.5 + 275 *screen_width / 1920",
        "height": " forge_progress_bar_percent(1)* screen_height * 0.6",
        "width": "screen_width * 52 /1920"
    },
    "texture": {
        "x": "0",
        "y": "0",
        "height": "forge_progress_bar_percent(1)",
        "width": "1"
    }
}

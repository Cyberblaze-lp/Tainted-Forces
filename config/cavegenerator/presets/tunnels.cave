# ----------------------------------------------------------- #
# ########################################################### #
#                 ### tunnels.cave Info ###                   #
# ########################################################### #
#   This preset is designed to demonstrate a basic use case   #
# for this mod. It converts the normal, winding tunnels into  #
# long, straight tunnels with some decorations.               #
# ----------------------------------------------------------- #
{
  $VANILLA: "ALL" # Default ravines and lava settings.
  enabled: true
  wallDecorators: []
  tunnels: {
    originHeight: [ 2, 200 ]
    systemChance: 0.8
    chance: 0.1
    noiseYReduction: false
    rooms: {
      scale: 6
      stretch: 0.5
      chance: 0.1
    }
    dYaw: {
      factor: 0.9
      randFactor: 0.3
      startVal: 0
    }
    dPitch: {
      factor: 0.9
      randFactor: 0.1
      startVal: 0
    }
    scale: {
      randFactor: 0.25
      startVal: 4
      startValRandFactor: 1
    }
    pitch: {
      startValRandFactor: 0.05
    }
    stretch: {
      randFactor: 0.1
      startVal: 0.5
    }
  }
}
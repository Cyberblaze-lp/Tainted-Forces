# ----------------------------------------------------------- #
# ########################################################### #
#              ### euclids_tunnels.cave Info ###              #
# ########################################################### #
#   This preset demonstrates a slightly more advanced use of  #
# the caverns feature. It is used in this preset to produce   #
# tunnel-like caves using cellular or voronoi noise           #
# generation. For more information on using noise3D blocks,   # 
# see vanilla.cave.                                           #
# ----------------------------------------------------------- #
{
  imports: [
    defaults.cave::caveBlocks as LAVA_CAVE_BLOCK
    blocks.cave::ROCKSTFC as ROCKSTFC
  ]
  variables: {}
  enabled: true
  tunnels: {
    replaceableBlocks: $ROCKSTFC
    count: 300
    originHeight: [ 30, 180 ]
    resolution: 4
    systemChance: 0.9
    chance: 1
    systemDensity: 4
    noiseYReduction: false
    distance: 200
    reseedBranches: true
    resizeBranches: true
    checkWater: true
    scale: {
      startVal: 0
      startValRandFactor: 2
      factor: 1
      randFactor: 0
      exponent: 1
    }
    stretch: 2
    yaw: {
      startVal: 0
      startValRandFactor: 1
    }
    pitch: {
      startVal: 0
      startValRandFactor: 0.25
    }
    dYaw: {
      startVal: 0
      factor: 0.75
      randFactor: 4
      exponent: 1
    }
    dPitch: {
      startVal: 0
      factor: 0.9
      randFactor: 2
      exponent: 1
    }
    rooms: {}
    # Just another tunnel generator. Infintely deep.
    branches: {}
    height: [ 8, 10 ]
    biomes: {}
    blacklistBiomes: false
    dimensions: []
    blacklistDimensions: false
    ceiling: {}
    floor: {}
    region: {}
    noise: {}
    replaceableBlocks: $ROCKSTFC
    replaceDecorators: true
    caveBlocks: []
    wallDecorators: []
    ponds: []
    shell: {}
  }
  # Default lava.
  caveBlocks: $LAVA_CAVE_BLOCK
}
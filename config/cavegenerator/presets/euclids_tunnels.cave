# ----------------------------------------------------------- #
# ########################################################### #
#              ### euclids_tunnels.cave Info ###              #
# ########################################################### #
#   This preset demonstrates a slightly more advanced use of  #
# the caverns feature. It is used in this preset to produce   #
# tunnel-like caves using cellular or voronoi noise           #
# generation. For more information on using noise3D blocks,   # 
# see vanilla.cave.                                           #
# ----------------------------------------------------------- #
{
  imports: [
    defaults.cave::caveBlocks as LAVA_CAVE_BLOCK
  ]
  variables: {
    ROCKSTFC: [ "tfc:fluid/fresh_water", "tfc:raw/chert", "tfc:gravel/chert", "tfc:sand/chert", "tfc:dirt/chert", "tfc:grass/chert", "tfc:dry_grass/chert", "tfc:raw/shale", "tfc:gravel/shale", "tfc:sand/shale", "tfc:dirt/shale", "tfc:grass/shale", "tfc:dry_grass/shale", "tfc:raw/slate", "tfc:gravel/slate", "tfc:sand/slate", "tfc:dirt/slate", "tfc:grass/slate", "tfc:dry_grass/slate", "tfc:raw/conglomerate", "tfc:gravel/conglomerate", "tfc:sand/conglomerate", "tfc:dirt/conglomerate", "tfc:grass/conglomerate", "tfc:dry_grass/conglomerate", "tfc:raw/limestone", "tfc:gravel/limestone", "tfc:sand/limestone", "tfc:dirt/limestone", "tfc:grass/limestone", "tfc:dry_grass/limestone", "tfc:raw/claystone", "tfc:gravel/claystone", "tfc:sand/claystone", "tfc:dirt/claystone", "tfc:grass/claystone", "tfc:dry_grass/claystone", "tfc:raw/quartzite", "tfc:gravel/quartzite", "tfc:sand/quartzite", "tfc:dirt/quartzite", "tfc:grass/quartzite", "tfc:dry_grass/quartzite", "tfc:raw/phyllite", "tfc:gravel/phyllite", "tfc:sand/phyllite", "tfc:dirt/phyllite", "tfc:grass/phyllite", "tfc:dry_grass/phyllite", "tfc:raw/schist", "tfc:gravel/schist", "tfc:sand/schist", "tfc:dirt/schist", "tfc:grass/schist", "tfc:dry_grass/schist", "tfc:raw/gneiss", "tfc:gravel/gneiss", "tfc:sand/gneiss", "tfc:dirt/gneiss", "tfc:grass/gneiss", "tfc:dry_grass/gneiss", "tfc:raw/chalk", "tfc:gravel/chalk", "tfc:sand/chalk", "tfc:dirt/chalk", "tfc:grass/chalk", "tfc:dry_grass/chalk", "tfc:raw/dolomite", "tfc:gravel/dolomite", "tfc:sand/dolomite", "tfc:dirt/dolomite", "tfc:grass/dolomite", "tfc:dry_grass/dolomite", "tfc:raw/marble", "tfc:gravel/marble", "tfc:sand/marble", "tfc:dirt/marble", "tfc:grass/marble", "tfc:dry_grass/marble", "tfc:raw/rocksalt", "tfc:gravel/rocksalt", "tfc:sand/rocksalt", "tfc:dirt/rocksalt", "tfc:grass/rocksalt", "tfc:dry_grass/rocksalt" ]
  }
  enabled: false
  tunnels: {
    replaceableBlocks: $ROCKSTFC
    biomes: {
      names: [ "tfc:plains", "tfc:rolling_hills", "tfc:high_plains" ]
    }
    count: 15
    originHeight: [ 60, 128 ]
    resolution: 4
    systemChance: 0.2
    chance: 0.3
    systemDensity: 6
    noiseYReduction: false
    distance: 0
    reseedBranches: true
    resizeBranches: true
    checkWater: true
    scale: {
      startVal: 0
      startValRandFactor: 1
      factor: 1
      randFactor: 0
      exponent: 1
    }
    stretch: 80
    yaw: {
      startVal: 0
      startValRandFactor: 1
    }
    pitch: {
      startVal: 0
      startValRandFactor: 0.25
    }
    dYaw: {
      startVal: 0
      factor: 0.75
      randFactor: 4
      exponent: 1
    }
    dPitch: {
      startVal: 0
      factor: 0.9
      randFactor: 2
      exponent: 1
    }
    rooms: {}
    # Just another tunnel generator. Infintely deep.
    branches: {}
    height: [ 8, 255 ]
    biomes: {}
    blacklistBiomes: false
    dimensions: []
    blacklistDimensions: false
    ceiling: {}
    floor: {}
    region: {}
    noise: {}
    replaceableBlocks: [ "stone", "dirt", "grass", "hardened_clay" ]
    replaceDecorators: true
    caveBlocks: []
    wallDecorators: []
    ponds: []
    shell: {}
  }
  # Default lava.
  caveBlocks: $LAVA_CAVE_BLOCK
}
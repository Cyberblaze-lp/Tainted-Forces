# ----------------------------------------------------------- #
# ########################################################### #
#                 ### caverns.cave Info ###                   #
# ########################################################### #
#   This preset demonstrates a basic use case of the caverns  #
# feature. For more information on using noise3D blocks, see  #
# vanilla.cave.                                               #
# ----------------------------------------------------------- #
{
  imports: [
    defaults.cave::caveBlocks as LAVA_CAVE_BLOCK
  ]
  $VANILLA: "ALL" # Default ravines and lava settings.
  enabled: false
  caverns: {
    distFunc: Manhattan
    height: [ 2, 50 ]
    generators: {
      frequency: 0.01
      threshold: -0.75
      stretch: 0.5
    }
  }
  caverns2: {
    height: [ 2, 50 ]
    distFunc: Manhattan
    generators: {
      frequency: 0.99
      threshold: -0.85
      stretch: 0.3
    }
  }
  tunnels: {
    # Spawn rate roughly in half.
    count: 1
    # Most tunnels will spawn together.
    systemChance: 0.5
    noiseYReduction: false
    resizeBranches: false
    dPitch: {
      factor: 0.5
    }
    scale: {
      randFactor: 0
      startVal: 4.5
      startValRandFactor: 0
    }
    stretch: {
      randFactor: 0
      startVal: 0.6
    }
  }
  caveBlocks: $LAVA_CAVE_BLOCK
}
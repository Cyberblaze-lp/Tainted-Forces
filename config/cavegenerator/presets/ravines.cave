# ----------------------------------------------------------- #
# ########################################################### #
#                 ### ravines.cave Info ###                   #
# ########################################################### #
#   This preset is designed to demonstrate a basic use case   #
# for Cave Generator which increases the frequency and shape  #
# of ravines, while disabling other cave-related features.    #
# ----------------------------------------------------------- #
{
  imports: [
    defaults.cave::caveBlocks as LAVA_CAVE_BLOCK
    blocks.cave::ROCKSTFC as ROCKSTFC
  ]
  enabled: true
  ravines: {
    biomes: {
      names: [ "tfc:plains", "tfc:rolling_hills", "tfc:high_plains", "tfc:high_hills_edge", "tfc:high_hills", "tfc:mountains_edge", "tfc:mountains" ]
    }
    replaceableBlocks: $ROCKSTFC
    checkWater: true
    chance: 0.001
    height: [ 134, 170 ]
    resolution: 2
    distance: 360
    dYaw: {
      startVal: 0
      factor: 0.5
      randFactor: 4
      exponent: 1
    }
    dPitch: {
      startVal: 0
      factor: 0.8
      randFactor: 2
      exponent: 1
    }
    scale: 16
    stretch: {
      startVal: 2
      factor: 1
      randFactor: 0.3
      exponent: 1
    }
    yaw: {
      startVal: 0
      startValRandFactor: 0.5
    }
    pitch: {
      startVal: 0
      startValRandFactor: 0.25
    }
    noiseYFactor: 0.6
  }
}
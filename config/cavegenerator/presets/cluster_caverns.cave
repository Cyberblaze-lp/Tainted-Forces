# ----------------------------------------------------------- #
# ########################################################### #
#              ### cluster_caverns.cave Info ###              #
# ########################################################### #
#   This preset is designed to demonstrate how you can        #
# combine the clusters feature with noise blocks to create    #
# biome-restricted caverns.                                   #
# ----------------------------------------------------------- #
{
  imports: [
    defaults.cave::caveBlocks as LAVA_CAVE_BLOCK
  ]
  enabled: false
  clusters: {
    states: air
    chance: 0.75
    radiusX: [ 28, 33 ]
    radiusY: [ 21, 26 ]
    radiusZ: [ 28, 33 ]
    centerHeight: [ 17, 39 ]
    noise: {
      frequency: 0.02
      stretch: 0.4
      threshold: -0.30000000000000004
    }
  }
  caveBlocks: $LAVA_CAVE_BLOCK
}
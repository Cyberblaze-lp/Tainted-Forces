# ----------------------------------------------------------- #
# ########################################################### #
#                 ### spirals.cave Info ###                   #
# ########################################################### #
#   This preset is designed to demonstrate a slightly more    #
# complex use case of the ScalableFloat values inside of the  #
# `tunnels` objects in cave presets. It has the effect of     #
# turning all tunnels generated into downward spirals.        #
# ----------------------------------------------------------- #
{
  enabled: false
  tunnels: {
    height: [ 10, 180 ]
    replaceableBlocks: [
      tfc:raw/basalt
      tfc:gravel/basalt
      tfc:sand/basalt
      tfc:dirt/basalt
      tfc:grass/basalt
      tfc:dry_grass/basalt
      tfc:raw/dacite
      tfc:gravel/dacite
      tfc:sand/dacite
      tfc:dirt/dacite
      tfc:grass/dacite
      tfc:dry_grass/dacite
      tfc:raw/andesite
      tfc:gravel/andesite
      tfc:sand/andesite
      tfc:dirt/andesite
      tfc:grass/andesite
      tfc:dry_grass/andesite
      tfc:raw/rhyolite
      tfc:gravel/rhyolite
      tfc:sand/rhyolite
      tfc:dirt/rhyolite
      tfc:grass/rhyolite
      tfc:dry_grass/rhyolite
      tfc:raw/diorite
      tfc:gravel/diorite
      tfc:sand/diorite
      tfc:dirt/diorite
      tfc:grass/diorite
      tfc:dry_grass/diorite
      tfc:raw/gabbro
      tfc:gravel/gabbro
      tfc:sand/gabbro
      tfc:dirt/gabbro
      tfc:grass/gabbro
      tfc:dry_grass/gabbro
      tfc:raw/granite
      tfc:gravel/granite
      tfc:sand/granite
      tfc:dirt/granite
      tfc:grass/granite
      tfc:dry_grass/granite
      tfc:raw/chert
      tfc:gravel/chert
      tfc:sand/chert
      tfc:dirt/chert
      tfc:grass/chert
      tfc:dry_grass/chert
      tfc:raw/shale
      tfc:gravel/shale
      tfc:sand/shale
      tfc:dirt/shale
      tfc:grass/shale
      tfc:dry_grass/shale
      tfc:raw/slate
      tfc:gravel/slate
      tfc:sand/slate
      tfc:dirt/slate
      tfc:grass/slate
      tfc:dry_grass/slate
      tfc:raw/conglomerate
      tfc:gravel/conglomerate
      tfc:sand/conglomerate
      tfc:dirt/conglomerate
      tfc:grass/conglomerate
      tfc:dry_grass/conglomerate
      tfc:raw/limestone
      tfc:gravel/limestone
      tfc:sand/limestone
      tfc:dirt/limestone
      tfc:grass/limestone
      tfc:dry_grass/limestone
      tfc:raw/claystone
      tfc:gravel/claystone
      tfc:sand/claystone
      tfc:dirt/claystone
      tfc:grass/claystone
      tfc:dry_grass/claystone
      tfc:raw/quartzite
      tfc:gravel/quartzite
      tfc:sand/quartzite
      tfc:dirt/quartzite
      tfc:grass/quartzite
      tfc:dry_grass/quartzite
      tfc:raw/phyllite
      tfc:gravel/phyllite
      tfc:sand/phyllite
      tfc:dirt/phyllite
      tfc:grass/phyllite
      tfc:dry_grass/phyllite
      tfc:raw/schist
      tfc:gravel/schist
      tfc:sand/schist
      tfc:dirt/schist
      tfc:grass/schist
      tfc:dry_grass/schist
      tfc:raw/gneiss
      tfc:gravel/gneiss
      tfc:sand/gneiss
      tfc:dirt/gneiss
      tfc:grass/gneiss
      tfc:dry_grass/gneiss
      tfc:raw/chalk
      tfc:gravel/chalk
      tfc:sand/chalk
      tfc:dirt/chalk
      tfc:grass/chalk
      tfc:dry_grass/chalk
      tfc:raw/dolomite
      tfc:gravel/dolomite
      tfc:sand/dolomite
      tfc:dirt/dolomite
      tfc:grass/dolomite
      tfc:dry_grass/dolomite
      tfc:raw/marble
      tfc:gravel/marble
      tfc:sand/marble
      tfc:dirt/marble
      tfc:grass/marble
      tfc:dry_grass/marble
      tfc:raw/rocksalt
      tfc:gravel/rocksalt
      tfc:sand/rocksalt
      tfc:dirt/rocksalt
      tfc:grass/rocksalt
      tfc:dry_grass/rocksalt
    ]
    checkWater: true
    systemChance: 0.001
    noiseYReduction: false
    dYaw: {
      # Twist is multiplied by this number. 1.0 means 
      # it stays the same. This allows yaw to remain
      # the same between sections.
      factor: 1
      randFactor: 0
      startVal: 2
    }
    dPitch: {
      # Don't twist vertically at all.
      factor: 1
      randFactor: 0
    }
    pitch: {
      # There has to be a vertical slope or only a ball
      # will generate.
      startVal: 1
      startValRandFactor: 0
    }
  }
}
# ----------------------------------------------------------- #
# ########################################################### #
#              ### euclids_tunnels.cave Info ###              #
# ########################################################### #
#   This preset demonstrates a slightly more advanced use of  #
# the caverns feature. It is used in this preset to produce   #
# tunnel-like caves using cellular or voronoi noise           #
# generation. For more information on using noise3D blocks,   # 
# see vanilla.cave.                                           #
# ----------------------------------------------------------- #
{
  enabled: false
  tunnels: {
    replaceableBlocks: [ "stone", "dirt", "grass", "hardened_clay" ]
    biomes: {}
    count: 15
    originHeight: [ 60, 128 ]
    resolution: 4
    systemChance: 0.2
    chance: 0.3
    systemDensity: 6
    noiseYReduction: false
    distance: 0
    reseedBranches: true
    resizeBranches: true
    checkWater: true
    scale: {
      startVal: 0
      startValRandFactor: 1
      factor: 1
      randFactor: 0
      exponent: 1
    }
    stretch: 80
    yaw: {
      startVal: 0
      startValRandFactor: 1
    }
    pitch: {
      startVal: 0
      startValRandFactor: 0.25
    }
    dYaw: {
      startVal: 0
      factor: 0.75
      randFactor: 4
      exponent: 1
    }
    dPitch: {
      startVal: 0
      factor: 0.9
      randFactor: 2
      exponent: 1
    }
    rooms: {}
    # Just another tunnel generator. Infintely deep.
    branches: {}
    height: [ 8, 255 ]
    blacklistBiomes: false
    dimensions: []
    blacklistDimensions: false
    ceiling: {}
    floor: {}
    region: {}
    noise: {}
    replaceDecorators: true
    caveBlocks: []
    wallDecorators: []
    ponds: []
    shell: {}
  }
  caveBlocks: {
    states: lava
    height: [
      0
      5
    ]
  }
}
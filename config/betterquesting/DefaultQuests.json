      "properties:10": {
        "betterquesting:10": {
          "name:8": "The Logistician",
          "desc:8": "§6§aCorporal Logan§f reporting for Duty! I\u0027m from supply chain management and have just been, uh, prematurely promoted to head of logistics.\nIf you have any deliveries to make or need help with getting things where they need to be, come to §mus§f me.",

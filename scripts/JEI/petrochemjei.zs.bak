
import mods.jei.JEI;
import mods.randomtweaker.jei.IJeiPanel;
import mods.randomtweaker.jei.IJeiUtils;
import mods.randomtweaker.jei.IJeiRecipe;



var keyJEI as IJeiPanel = JEI.createJei("test_jei", "key");

keyJEI.setModid("www");

keyJEI.setBackground(IJeiUtils.createBackground(150, 50));

keyJEI.addRecipeCatalyst(<minecraft:stone:3>);
keyJEI.addRecipeCatalyst(<minecraft:stone:1>);

keyJEI.addSlot(IJeiUtils.createItemSlot(16, 18, true));
keyJEI.addSlot(IJeiUtils.createItemSlot(80, 18, false));

keyJEI.addElement(IJeiUtils.createFontInfoElement("font", 50, 50,  0x000000));
keyJEI.addElement(IJeiUtils.createFontInfoElement("fontInfo", 100, 18, 0x52575B));

keyJEI.register();



var test_recipe as IJeiRecipe = JEI.createJeiRecipe("test_jei");

test_recipe.addInput(<minecraft:apple>);

test_recipe.addOutput(<minecraft:golden_apple:1>);

test_recipe.build();





var bllightning as IJeiPanel = JEI.createJei("bllightning", "Throw in Lightning");

bllightning.setModid("thebetweenlands");

bllightning.setBackground(IJeiUtils.createBackground(150, 50));

bllightning.addRecipeCatalyst(<minecraft:stone:3>);
bllightning.addRecipeCatalyst(<thebetweenlands:simulacrum_deepman>);

bllightning.addSlot(IJeiUtils.createItemSlot(16, 18, true));
bllightning.addSlot(IJeiUtils.createItemSlot(80, 18, false));


bllightning.register();



var lightning1 as IJeiRecipe = JEI.createJeiRecipe("bllightning");

lightning1.addInput(<ore:arrowBL>);

lightning1.addOutput(<thebetweenlands:shock_arrow>);

lightning1.build();
